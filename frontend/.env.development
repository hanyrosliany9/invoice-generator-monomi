# Development environment variables
# Backend API runs on port 5000 in development.
# Using a RELATIVE URL routes every API call through Vite's /api proxy, which
# works identically on localhost:3000, LAN IPs (Tailscale), and public tunnels
# (ngrok / cloudflared) — none of which would expose backend port 5000 directly.
VITE_API_URL=/api

# Redux DevTools (Zustand devtools middleware)
# Set to 'true' to enable Redux DevTools Extension for debugging Zustand store
# WARNING: Enabling this may cause browser dev tools to open automatically
# Default: disabled
# VITE_ENABLE_REDUX_DEVTOOLS=true
