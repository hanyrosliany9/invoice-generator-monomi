# Database
DATABASE_URL="postgresql://username:password@localhost:5432/invoice_generator?schema=public"
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=invoice_generator

# JWT Authentication
JWT_SECRET=your_very_secure_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Client portal (portal.monomiagency.com) — separate login for client contacts.
# PORTAL_JWT_SECRET signs portal sessions + login-code HMACs. REQUIRED in
# production (app refuses to boot without it), >= 32 chars, MUST differ from
# JWT_SECRET, and must be random: production also refuses this placeholder,
# anything containing "change-me"/"example"/"placeholder", and low-entropy
# values. Generate one with:
#   openssl rand -base64 48
PORTAL_JWT_SECRET=change-me-to-a-different-long-random-secret
# Public URL of the client portal (CORS origin + link in invite emails)
PORTAL_URL=https://portal.monomiagency.com

# Instagram API with Instagram Login (optional; Business/Creator accounts).
# Leave META_APP_ID / META_APP_SECRET empty to keep the feature off (the app
# still boots; Instagram cards say "not configured"). When set:
#  - TOKEN_ENCRYPTION_KEY is REQUIRED in production: 32 random bytes, base64
#    (encrypts stored access tokens with AES-256-GCM). Generate with:
#      openssl rand -base64 32
#    Keep it stable and backed up: tokens encrypted under another key cannot be
#    read. A wrong key never deletes tokens - the nightly sync aborts (logs
#    "ABORTED ... TOKEN_ENCRYPTION_KEY") or flags the connection "Token key
#    mismatch"; restoring the original key recovers automatically. Clients
#    only need to reconnect if the original key is lost.
#  - Register these in the Meta app dashboard (Instagram > API setup with
#    Instagram login > Business login settings):
#      OAuth redirect URIs: https://admin.monomiagency.com/api/v1/instagram/oauth/callback
#                           https://portal.monomiagency.com/api/v1/instagram/oauth/callback
#      Deauthorize callback: https://admin.monomiagency.com/api/v1/instagram/deauthorize
#      Data deletion request: https://admin.monomiagency.com/api/v1/instagram/data-deletion
META_APP_ID=
META_APP_SECRET=
# Graph API version (v26.0 released 2026-07-29; bump when Meta deprecates it)
META_GRAPH_VERSION=v26.0
TOKEN_ENCRYPTION_KEY=
# Defaults: https://admin.monomiagency.com/... (staff) and PORTAL_URL origin + /api/v1/instagram/oauth/callback (portal)
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_PORTAL_REDIRECT_URI=
# Optional tuning (comma lists of metric names; unsupported metrics are skipped automatically):
# INSTAGRAM_ACCOUNT_METRICS=reach,views,accounts_engaged,total_interactions,likes,comments,shares,saves,replies,reposts,profile_links_taps,follows_and_unfollows
# INSTAGRAM_FEED_METRICS / INSTAGRAM_REELS_METRICS / INSTAGRAM_STORY_METRICS / INSTAGRAM_MEDIA_FIELDS
# INSTAGRAM_BACKFILL_DAYS=30  INSTAGRAM_MEDIA_LOOKBACK_DAYS=90  INSTAGRAM_SYNC_ENABLED=true  INSTAGRAM_STORY_SYNC_ENABLED=true

# Auto-publishing Monomi's OWN content-calendar posts to Instagram + the
# Facebook Page (optional). Leave all three empty to keep it off (the app boots;
# the calendar shows "not configured"). Phase 1 publishes for the internal
# client (Monomi) only. Setup in Meta Business Settings:
#  1. Users > System users: create an Admin (or Employee) system user.
#  2. Assign assets to it: the Monomi Facebook Page (with "Content" / create
#     content access) and the Instagram account linked to that Page, and add
#     the Meta app the token is generated for (Apps > Add assets).
#  3. Generate token (never-expiring) with: pages_show_list,
#     pages_read_engagement, pages_manage_posts, instagram_basic,
#     instagram_content_publish, business_management.
#  4. META_PAGE_ID = numeric Page id; META_IG_USER_ID = the Page's
#     instagram_business_account.id (the calendar's "Check connection" shows it).
# The token is read from the environment only: never stored, logged or
# returned by the API. Graph version is shared with META_GRAPH_VERSION.
META_SYSTEM_USER_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# Optional: app secret of the app that owns the token -> appsecret_proof on every call
META_SYSTEM_APP_SECRET=
# Optional kill switch for the every-minute auto-publish job (true/false)
META_AUTOPUBLISH_ENABLED=true
# Dev only (ignored in production): point at a fake Graph server for local tests
# INSTAGRAM_AUTHORIZE_URL=  INSTAGRAM_OAUTH_BASE_URL=  INSTAGRAM_GRAPH_BASE_URL=

# WhatsApp Business Platform inbox (CRM phase B; optional - all empty = off).
# Coexistence: the business keeps using the WhatsApp Business app on the phone;
# Monomi mirrors chats (webhooks) and can reply through the Cloud API.
# NEVER register / verify / migrate the number via SMS code or PIN in Meta -
# that logs the phone app out (the backend refuses those endpoints anyway).
#  - WHATSAPP_ACCESS_TOKEN: System User token (Business Settings > System users),
#    assigned to the app AND the WABA, permissions whatsapp_business_messaging +
#    whatsapp_business_management (+ whatsapp_business_manage_events for CAPI).
#  - Webhook (Meta app > WhatsApp > Configuration):
#      Callback URL: https://admin.monomiagency.com/api/v1/whatsapp/webhook
#      Verify token: WHATSAPP_WEBHOOK_VERIFY_TOKEN (generate: openssl rand -hex 24)
#      Fields: messages, smb_message_echoes, history, smb_app_state_sync, account_update
#    Payloads are signed with the Meta APP SECRET (META_APP_SECRET above). If the
#    WhatsApp product lives in a different Meta app than Instagram, set
#    WHATSAPP_APP_SECRET / WHATSAPP_APP_ID for it instead.
#  - Production refuses to boot with a placeholder verify token or without an
#    app secret once any WHATSAPP_* value is set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Embedded Signup for coexistence (needs Tech Provider approval; keep false until then)
WHATSAPP_COEXISTENCE_ENABLED=false
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# History sync creates leads only for chats newer than N days (ad chats always; 0 = never)
# WHATSAPP_HISTORY_LEAD_MAX_AGE_DAYS=30  WHATSAPP_HISTORY_SYNC_ENABLED=true  WHATSAPP_SMB_SYNC_EDGE=smb_app_data
# Conversions API for Business Messaging (send nothing until Meta approves access)
#  META_DATASET_ID: POST /{WABA_ID}/dataset (or the button in CRM settings)
#  META_CAPI_TEST_EVENT_CODE: Events Manager > Test events (remove after testing)
META_DATASET_ID=
META_CAPI_ENABLED=false
META_CAPI_TEST_EVENT_CODE=
# Dev only (ignored in production): fake Graph server for local tests
# WHATSAPP_GRAPH_BASE_URL=http://127.0.0.1:5499

# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# WebSocket & Real-time Collaboration
SOCKET_IO_CORS_ORIGIN=http://localhost:3001
VITE_WS_URL=http://localhost:5000

# PDF Export (Puppeteer)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
TEMP_EXPORT_DIR=./temp/exports

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME="Indonesian Business System"

# Redis (Session Management)
REDIS_URL=redis://localhost:6379

# Payment Gateways
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_PATH=./uploads

# Indonesian APIs
CURRENCY_API_KEY=your_currency_api_key
LOCATION_API_URL=https://api.binderbyte.com/wilayah

# ============================================
# External API Configuration (Call Sheet Auto-Fill)
# ============================================
# All APIs used are FREE with no API keys required:
# - Nominatim (OpenStreetMap) - Geocoding
# - Open-Meteo - Weather forecasts
# - Sunrise-Sunset.org - Sun times
# - Overpass API (OpenStreetMap) - Hospital search

# API Timeouts (milliseconds)
EXTERNAL_API_TIMEOUT=10000           # 10 seconds for most APIs
OVERPASS_API_TIMEOUT=15000           # 15 seconds (Overpass is slower)

# Nominatim Rate Limiting (REQUIRED - OpenStreetMap policy)
GEOCODING_RATE_LIMIT_MS=1000         # 1 second between requests (do not reduce!)

# Hospital Search Configuration
HOSPITAL_SEARCH_RADIUS_KM=5          # Initial search radius (expands to 10km, then 20km if needed)

# Google Maps (for address autocomplete in frontend)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Future: Paid API Keys (Optional - currently unused)
# OPENWEATHER_API_KEY=your_api_key_here

# Security
RATE_LIMIT_TTL=60000  # 1 minute
RATE_LIMIT_MAX=100    # requests per minute

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Database Initialization
# Set to 'false' to enable automatic database seeding on container startup
# Set to 'true' to skip database initialization (useful for production)
SKIP_DB_INIT=false