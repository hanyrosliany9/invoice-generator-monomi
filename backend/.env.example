# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env to version control!

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=5000

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://invoiceuser:devpassword@db:5432/invoices

# Database initialization
# Set to 'true' to skip automatic database seeding on startup
SKIP_DB_INIT=false

# ===========================================
# REDIS (Session & Cache)
# ===========================================
REDIS_URL=redis://redis:6379

# ===========================================
# SECURITY
# ===========================================
# JWT secret for authentication tokens (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# JWT expiration time
JWT_EXPIRES_IN=24h

# Client portal (portal.monomiagency.com) — separate login for client contacts.
# PORTAL_JWT_SECRET signs portal sessions + login-code HMACs. REQUIRED in
# production (app refuses to boot without it), >= 32 chars, MUST differ from
# JWT_SECRET, and must be random: production also refuses this placeholder,
# anything containing "change-me"/"example"/"placeholder", and low-entropy
# values. Generate one with:
#   openssl rand -base64 48
PORTAL_JWT_SECRET=change-me-to-a-different-long-random-secret
# Public URL of the client portal (CORS origin + link in invite emails)
PORTAL_URL=https://portal.monomiagency.com

# Instagram API with Instagram Login (optional; Business/Creator accounts).
# Leave META_APP_ID / META_APP_SECRET empty to keep the feature off (the app
# still boots; Instagram cards say "not configured"). When set:
#  - TOKEN_ENCRYPTION_KEY is REQUIRED in production: 32 random bytes, base64
#    (encrypts stored access tokens with AES-256-GCM). Generate with:
#      openssl rand -base64 32
#    Keep it stable and backed up: tokens encrypted under another key cannot be
#    read. A wrong key never deletes tokens - the nightly sync aborts (logs
#    "ABORTED ... TOKEN_ENCRYPTION_KEY") or flags the connection "Token key
#    mismatch"; restoring the original key recovers automatically. Clients
#    only need to reconnect if the original key is lost.
#  - Register these in the Meta app dashboard (Instagram > API setup with
#    Instagram login > Business login settings):
#      OAuth redirect URIs: https://admin.monomiagency.com/api/v1/instagram/oauth/callback
#                           https://portal.monomiagency.com/api/v1/instagram/oauth/callback
#      Deauthorize callback: https://admin.monomiagency.com/api/v1/instagram/deauthorize
#      Data deletion request: https://admin.monomiagency.com/api/v1/instagram/data-deletion
META_APP_ID=
META_APP_SECRET=
# Graph API version (v26.0 released 2026-07-29; bump when Meta deprecates it)
META_GRAPH_VERSION=v26.0
TOKEN_ENCRYPTION_KEY=
# Defaults: https://admin.monomiagency.com/... (staff) and PORTAL_URL origin + /api/v1/instagram/oauth/callback (portal)
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_PORTAL_REDIRECT_URI=
# Optional tuning (comma lists of metric names; unsupported metrics are skipped automatically):
# INSTAGRAM_ACCOUNT_METRICS=reach,views,accounts_engaged,total_interactions,likes,comments,shares,saves,replies,reposts,profile_links_taps,follows_and_unfollows
# INSTAGRAM_FEED_METRICS / INSTAGRAM_REELS_METRICS / INSTAGRAM_STORY_METRICS / INSTAGRAM_MEDIA_FIELDS
# INSTAGRAM_BACKFILL_DAYS=30  INSTAGRAM_MEDIA_LOOKBACK_DAYS=90  INSTAGRAM_SYNC_ENABLED=true  INSTAGRAM_STORY_SYNC_ENABLED=true
# Dev only (ignored in production): point at a fake Graph server for local tests
# INSTAGRAM_AUTHORIZE_URL=  INSTAGRAM_OAUTH_BASE_URL=  INSTAGRAM_GRAPH_BASE_URL=

# ===========================================
# FRONTEND
# ===========================================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# ===========================================
# EMAIL (SMTP)
# ===========================================
# SMTP server configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=noreply@monomi.finance
FROM_NAME=Monomi Invoice System

# ===========================================
# INDONESIAN BUSINESS SETTINGS
# ===========================================
# Materai (stamp duty) threshold in IDR
MATERAI_THRESHOLD=5000000

# Default tax rate (PPN - Indonesian VAT)
DEFAULT_TAX_RATE=11

# ===========================================
# FILE STORAGE
# ===========================================
# Upload and storage paths (relative to app root)
UPLOAD_PATH=./uploads
STORAGE_PATH=./storage

# Maximum file upload size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# ===========================================
# CLOUDFLARE R2 STORAGE (For Content Planning Calendar & PDF Reports)
# ===========================================
# Cloudflare R2 configuration for media storage and PDF reports
# Get these from: https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Maximum media file size in MB (default: 100MB for images/videos, PDFs can be larger)
MAX_FILE_SIZE_MB=100

# ===========================================
# PDF GENERATION
# ===========================================
# Puppeteer configuration
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_TIMEOUT=30000

# ===========================================
# RATE LIMITING
# ===========================================
# Throttle configuration (requests per TTL window)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ===========================================
# LOGGING
# ===========================================
# Log level: error, warn, log, debug, verbose
LOG_LEVEL=debug

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable/disable features
ENABLE_METRICS=true
ENABLE_SWAGGER=true
ENABLE_AUDIT_LOG=true

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# Enable debug mode (DO NOT USE IN PRODUCTION)
DEBUG=false

# Disable authentication for testing (DANGEROUS - DEV ONLY)
DISABLE_AUTH=false
