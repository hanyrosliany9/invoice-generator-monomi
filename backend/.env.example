# WhatsApp Business Platform inbox (CRM phase B; optional - all empty = off).
# Coexistence: the business keeps using the WhatsApp Business app on the phone;
# Monomi mirrors chats (webhooks) and can reply through the Cloud API.
# NEVER register / verify / migrate the number via SMS code or PIN in Meta -
# that logs the phone app out (the backend refuses those endpoints anyway).
#  - WHATSAPP_ACCESS_TOKEN: System User token (Business Settings > System users),
#    assigned to the app AND the WABA, permissions whatsapp_business_messaging +
#    whatsapp_business_management (+ whatsapp_business_manage_events for CAPI).
#  - Webhook (Meta app > WhatsApp > Configuration):
#      Callback URL: https://admin.monomiagency.com/api/v1/whatsapp/webhook
#      Verify token: WHATSAPP_WEBHOOK_VERIFY_TOKEN (generate: openssl rand -hex 24)
#      Fields: messages, smb_message_echoes, history, smb_app_state_sync, account_update
#    Payloads are signed with the Meta APP SECRET (META_APP_SECRET above). If the
#    WhatsApp product lives in a different Meta app than Instagram, set
#    WHATSAPP_APP_SECRET / WHATSAPP_APP_ID for it instead.
#  - Production refuses to boot with a placeholder verify token or without an
#    app secret once any WHATSAPP_* value is set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Embedded Signup for coexistence (needs Tech Provider approval; keep false until then)
WHATSAPP_COEXISTENCE_ENABLED=false
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# History sync creates leads only for chats newer than N days (ad chats always; 0 = never)
# WHATSAPP_HISTORY_LEAD_MAX_AGE_DAYS=30  WHATSAPP_HISTORY_SYNC_ENABLED=true  WHATSAPP_SMB_SYNC_EDGE=smb_app_data
# Conversions API for Business Messaging (send nothing until Meta approves access)
#  META_DATASET_ID: POST /{WABA_ID}/dataset (or the button in CRM settings)
#  META_CAPI_TEST_EVENT_CODE: Events Manager > Test events (remove after testing)
META_DATASET_ID=
META_CAPI_ENABLED=false
META_CAPI_TEST_EVENT_CODE=
# Dev only (ignored in production): fake Graph server for local tests
# WHATSAPP_GRAPH_BASE_URL=http://127.0.0.1:5499
